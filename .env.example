PORT=3000
# Restrict WebSocket connections to your site (recommended in production)
ALLOWED_ORIGIN=
# Optional: override STUN servers (comma separated)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN (optional but recommended). Comma-separated URLs:
TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# Option A (coturn use-auth-secret): server issues 1-hour credentials per request
TURN_SECRET=
# Option B (static credentials from a TURN provider)
TURN_USERNAME=
TURN_CREDENTIAL=
